# LOCAL TEST ONLY. Copy to .env; never commit .env.
DATABASE_URL=sqlite:///./vaynexo.db
APP_ENV=development
DEMO_LOGIN_ENABLED=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Optional: generate a DIFFERENT long key for the local admin panel.
ADMIN_KEY=
ADMIN_TELEGRAM_IDS=[]
BOT_TOKEN=
# Set your HTTPS Mini App URL before starting the Telegram bot.
MINI_APP_URL=

# News imports (server only)
NEWS_API_KEY=
NEWS_CRON_SECRET=
