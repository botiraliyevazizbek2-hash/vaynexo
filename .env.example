# LOCAL TEST ONLY. Copy to .env; never commit .env.
DATABASE_URL=sqlite:///./vaynexo.db
APP_ENV=development
DEMO_LOGIN_ENABLED=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Optional: generate a DIFFERENT long key for the local admin panel.
ADMIN_KEY=
ADMIN_TELEGRAM_IDS=[]
BOT_TOKEN=
# Set your HTTPS Mini App URL before starting the Telegram bot.
MINI_APP_URL=

# AI Coach (server only; off by default)
OPENAI_API_KEY=
AI_ENABLED=false
AI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=10
